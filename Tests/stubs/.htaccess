# The Authorization header is not passed to PHP under CGI/FastCGI unless the server is told to.
# Both directives below are harmless when PHP runs as an Apache module.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_cgi.c>
    CGIPassAuth On
</IfModule>

<IfModule mod_proxy_fcgi.c>
    CGIPassAuth On
</IfModule>
