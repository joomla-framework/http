{
    "name": "joomla/http",
    "type": "joomla-package",
    "description": "Joomla HTTP Package",
    "keywords": ["joomla", "framework", "http"],
    "homepage": "https://github.com/joomla-framework/http",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "joomla/uri": "^4.0",
        "composer/ca-bundle": "^1.3.5",
        "laminas/laminas-diactoros": "^3.6.0"
    },
    "require-dev": {
        "joomla/test": "^4.0",
        "phpunit/phpunit": "^12.2.6",
        "squizlabs/php_codesniffer": "^3.7.2",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-deprecation-rules": "^2.0.3"
    },
    "suggest": {
        "ext-curl": "To use cURL for HTTP connections"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Http\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable"
}
